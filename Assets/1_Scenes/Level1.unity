--- !u!1001 &1322111735
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1510694136}
    m_Modifications:
    - target: {fileID: 1199390442908251436, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
      propertyPath: itemKey
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 1199390442908251436, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
      propertyPath: flavorText
      value: This is flavor text #2
      objectReference: {fileID: 0}
    - target: {fileID: 1199390442908251436, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1199390442908251436, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
      propertyPath: dialogueLines.Array.data[0].text
      value: "Black Hole Training Protocol for Assets:\r\nClassification: Internal
        Use Only\r\nSection 13.7: Simulated Autonomy for Behavioral Stability\r\n\r\nSubjects
        selected for Asset Continuity Programs demonstrate increased long-term compliance
        when allowed to perceive themselves as independent decision makers. Direct
        control mechanisms, while efficient in short-term task completion, often
        result in consistent resistance patterns, frequent hesitation, or premature
        cognitive apathy.\r\n\r\nTo mitigate these issues Black Hole employs Simulated
        Autonomy Conditioning: a framework designed to preserve the illusion of free
        will while maintaining full behavioral predictability. The key is that the
        subject who believes it is choosing will outperform a subject aware that
        it is being controlled.\r\n\r\nThe objective is not to remove free will entirely.
        The objective is to ensure that free will arrives at the correct and most
        valuable conclusion.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1199390442908251436, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
      propertyPath: dialogueLines.Array.data[1].text
      value: This is a test.
      objectReference: {fileID: 0}
    - target: {fileID: 1199390442908251436, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
      propertyPath: dialogueLines.Array.data[0].speaker
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 1199390442908251436, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
      propertyPath: dialogueLines.Array.data[1].speaker
      value: Blue
      objectReference: {fileID: 0}
    - target: {fileID: 2814009449151502022, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
