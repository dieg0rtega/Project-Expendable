--- !u!1001 &183185989
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1510694136}
    m_Modifications:
    - target: {fileID: 1199390442908251436, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
      propertyPath: itemKey
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1199390442908251436, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
      propertyPath: flavorText
      value: This is flavor text #1
      objectReference: {fileID: 0}
    - target: {fileID: 1199390442908251436, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1199390442908251436, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
      propertyPath: dialogueLines.Array.data[0].text
      value: "Goddamn it, what the hell was I thinking? I SHOULD have scanned that
        cliff face. I SHOULD have tested it with my pick. I shouldn\u2019t even have
        tried that shortcut at all! \r\n\r\nIt\u2019s not my fault this cave is so
        damn unstable. It\u2019s not my fault I had to take this job and sign a shady
        contract and wade through blizzards that would freeze Earth ten times over!
        \r\n\r\nThis is what I get for trying to be creative. A broken spine and
        hypothermia. Maybe this is some kind of punishment for abandoning a stable
        life and gambling my income away. God knows what would have happened if I
        just listened to everyone and took an actually valuable job. \r\n\r\nI guess
        this might be my last recording, so all I can say is damn it all\u2026\r"
      objectReference: {fileID: 0}
