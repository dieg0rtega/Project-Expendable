--- !u!1001 &1462128858
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1309646609}
    m_Modifications:
    - target: {fileID: 1199390442908251436, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
      propertyPath: flavorText
      value: "A good paragraph provides information on one well-defined aspect of
        the topic you\u2019re discussing in your article. Consider the two paragraphs
        under the previous heading in this article, for example. They address why
        paragraphs make your text easy to scan. In addition, it\u2019s good practice
        to start your paragraphs with a core sentence that summarizes the paragraph\u2019s
        content. This will help readers decide whether a paragraph is interesting
        to read.  "
      objectReference: {fileID: 0}
    - target: {fileID: 1199390442908251436, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1199390442908251436, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
      propertyPath: dialogueLines.Array.data[0].text
      value: "Okay. Okay. If I just\u2013 If I just make it past this part, I can\u2013
        I can figure out the rest later. That\u2019s fair, right? That\u2019s a fair
        deal for you, isn\u2019t it?\r\n\r\nYou don\u2019t have to help me. I\u2019m
        not asking for help. Just\u2026some luck. Some stability. No surprises. Is
        that too much to ask?\r\n\r\nGods, my hands are shaking. No, that\u2019s
        fine. That\u2019s normal. I\u2019m just cold. The suit\u2019s just compensating.
        It\u2019s not fear. I\u2019m not scared. I\u2019m not afraid. There\u2019s
        nothing that\u2019s going to kill me. It\u2019s just a cave. Just a mountain.
        Just a\u2013\r\n\r\nWho is \u201Cyou\u2019? Who am I even talking to at this
        point? It doesn\u2019t matter. Something is out there. Something controlling
        this entire universe. There has to be. This all can\u2019t just be chance
        and random miracles or strategies. Please\u2013\r\n\r\nNo, no \u201Cplease.\u201D
        I\u2019m not going to beg for something I deserve. \r\n\r\nThis matters,
        right? All of this has to matter in some way\u2026\r\n\r\nNo, I want to live!
        I\u2019ll give you anything! My stories, my body, my mind. Please, just let
        me survive\u2026\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 1199390442908251436, guid: e20631cd1f1624d4785fddc3eb45725d, type: 3}
      propertyPath: dialogueLines.Array.data[1].text
      value: this is a test
      objectReference: {fileID: 0}
